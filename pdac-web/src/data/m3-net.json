  "tracks": [
    {
      "id": "house",
      "tab": "Like a house",
      "label": "Layers, not walls",
      "steps": [
        {
          "title": "No single control is trusted alone",
          "text": "A house has a fence and gate, locked rooms, an alarm, a key for each person and a safe. The RSSO puts the same five layers between an attacker and the applicant database, so that **when one fails, the next one holds**.",
          "pre": {
            "firewall": "focus|1 Fence",
            "staffpc": "focus|2 Rooms",
            "ana": "focus|3 Alarm",
            "portal": "focus|4 Keys",
            "db": "focus|5 Safe"
          }
        }
      ]
    },
    {
      "id": "l1",
      "tab": "1 Perimeter",
      "label": "Layer 1 · the fence and gate",
      "steps": [
        {
          "title": "The firewall at the internet edge",
          "text": "An internet scan looks for the portal's admin page. The firewall lets citizens reach the portal's public pages, and nothing else.",
          "send": [
            {
              "route": [
                "citizen",
                "net",
                "firewall",
                "portal"
              ],
              "label": "Apply online"
            },
            {
              "route": [
                "attacker",
                "net",
                "firewall",
                "portal"
              ],
              "kind": "attack",
              "label": "Admin page?",
              "blockAt": "firewall"
            }
          ],
          "set": {
            "firewall": "ok|✓ Blocked",
            "citizen": "ok|✓ Page loads"
          }
        }
      ]
    },
    {
      "id": "l2",
      "tab": "2 Separate rooms",
      "label": "Layer 2 · locked rooms inside",
      "steps": [
        {
          "title": "Say layer 1 is beaten: a click inside",
          "text": "A staff member opens a phishing link. Malware is now **inside** the perimeter, on a staff PC. The firewall at the edge cannot help with that.",
          "pre": {
            "staffpc": "bad|✗ Malware"
          }
        },
        {
          "title": "The next layer holds: zones",
          "text": "The staff network may reach the portal and the file server, not the database directly. Every connection between zones passes the firewall's rules.",
          "pre": {
            "staffpc": "bad|✗ Malware"
          },
          "send": [
            {
              "route": [
                "staffpc",
                "firewall",
                "db"
              ],
              "kind": "attack",
              "label": "Database?",
              "blockAt": "firewall"
            }
          ],
          "set": {
            "staffpc": "warn|Contained",
            "firewall": "ok|✓ Blocked"
          },
          "verdict": {
            "tone": "ok",
            "text": "One infected PC cannot reach the applicant database."
          }
        }
      ]
    },
    {
      "id": "l3",
      "tab": "3 Alarm",
      "label": "Layer 3 · the burglar alarm",
      "steps": [
        {
          "title": "Monitoring: someone is told",
          "text": "The malware tries door after door. Each blocked try is logged, and the intrusion detection system raises an alert on Ana's screen. Now a person can act.",
          "pre": {
            "staffpc": "warn|Contained"
          },
          "send": [
            {
              "route": [
                "staffpc",
                "firewall",
                "backup"
              ],
              "kind": "attack",
              "label": "Backup?",
              "blockAt": "firewall"
            },
            {
              "route": [
                "staffpc",
                "firewall",
                "ana"
              ],
              "kind": "attack",
              "label": "Admin?",
              "blockAt": "firewall"
            }
          ],
          "set": {
            "ana": "warn|🔔 Alert",
            "firewall": "ok|Logged"
          }
        }
      ]
    },
    {
      "id": "l4",
      "tab": "4 A key each",
      "label": "Layer 4 · a key for each person",
      "steps": [
        {
          "title": "Named accounts, MFA and roles",
          "text": "The malware stole Ben's password, and the attacker tries the portal's staff login from outside. MFA asks for a second proof that only Ben has, so the login fails.",
          "send": [
            {
              "route": [
                "attacker",
                "net",
                "firewall",
                "portal"
              ],
              "kind": "attack",
              "label": "Ben's password",
              "blockAt": "portal"
            }
          ],
          "set": {
            "portal": "ok|✓ MFA refused",
            "attacker": "bad|✗ Refused"
          }
        }
      ]
    },
    {
      "id": "l5",
      "tab": "5 Safe",
      "label": "Layer 5 · a safe for valuables",
      "steps": [
        {
          "title": "Encryption of the database and backups",
          "text": "Suppose everything else fails and a backup drive walks out of the server room. It is encrypted, and the key is kept elsewhere: the thief has scrambled bytes, not 48,000 records.",
          "set": {
            "backup": "ok|🔒 Unreadable",
            "db": "ok|🔒 Encrypted"
          },
          "close": true,
          "verdict": {
            "tone": "ok",
            "text": "Five layers: each failure was caught by the next one."
          }
        }
      ]
    }
  ],
