  "tracks": [
    {
      "id": "sms",
      "tab": "Code by SMS",
      "label": "Better than a password alone",
      "steps": [
        {
          "title": "A link to a page that looks exactly right",
          "text": "Ben opens a link in a message. The page copies the portal's sign-in screen; its address has a zero in place of the letter o.",
          "pre": {
            "fake": "focus|Looks real"
          }
        },
        {
          "title": "Ben types his password",
          "text": "The fake page passes it to the attacker, who signs in to the **real** portal as Ben. The portal asks for the SMS code.",
          "send": [
            {
              "route": [
                "ben",
                "fake"
              ],
              "label": "Password"
            },
            {
              "route": [
                "fake",
                "attacker"
              ],
              "kind": "attack",
              "label": "Password"
            },
            {
              "route": [
                "attacker",
                "net",
                "portal"
              ],
              "kind": "attack",
              "label": "Sign in as Ben"
            }
          ],
          "set": {
            "portal": "warn|Asks for SMS code"
          },
          "ask": {
            "q": "Ben uses MFA by SMS. Is he safe now?",
            "options": [
              "Yes: the attacker has no code",
              "No: the fake page can ask for the code too"
            ],
            "answer": 1,
            "why": "The code goes to Ben's phone, and the fake page simply asks Ben to type it in."
          }
        },
        {
          "title": "The code is typed into the fake page",
          "text": "The portal texts Ben a code. Ben types it into the fake page, which passes it on within seconds.",
