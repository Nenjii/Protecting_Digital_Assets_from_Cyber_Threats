    {
      "id": "push",
      "tab": "Push with number matching",
      "label": "Stronger",
      "steps": [
        {
          "title": "Prompts Ben did not start",
          "text": "The attacker has Ben's password and signs in again and again, hoping Ben taps Approve to stop the prompts: MFA fatigue.",
          "send": [
            {
              "route": [
                "attacker",
                "net",
                "portal"
              ],
              "kind": "attack",
              "label": "Sign in as Ben"
            },
            {
              "route": [
                "portal",
                "phone"
              ],
              "label": "Approve?"
            }
          ],
          "set": {
            "phone": "warn|Asks a number"
          }
        },
        {
          "title": "Number matching blunts it",
          "text": "To approve, Ben must type the number on the sign-in screen. He is not signing in, so there is no number to type: he **denies the prompt and reports it**. CISA calls number matching an interim step.",
          "send": [
            {
              "route": [
                "phone",
                "portal"
              ],
              "kind": "secure",
              "label": "Denied"
            }
          ],
          "set": {
            "phone": "ok|✓ Denied",
            "portal": "ok|Sign-in refused"
          },
          "close": true
        }
      ]
    },
    {
      "id": "key",
      "tab": "Security key or passkey",
      "label": "Strongest: resists phishing",
      "desk": "Turn on MFA wherever it is offered; deny prompts you did not start.",
      "it": "MFA first on email, VPN and admin accounts; security keys for admins.",
      "steps": [
        {
          "title": "The same fake page, with a security key",
          "text": "Ben clicks the same link. This time he signs in with his security key (a passkey works the same way).",
          "pre": {
            "fake": "focus|Looks real"
          },
          "ask": {
            "q": "What does the key do on the fake page?",
            "options": [
              "Signs in, like a code",
              "Refuses: it checks the site's address",
              "Asks Ben to type a code"
            ],
            "answer": 1,
            "why": "The key was registered for assist.rsso-q.example. On any other address it will not sign in."
          }
        },
        {
          "title": "A fake page cannot use it",
          "text": "The key checks the real site's address. assist.rss0-q.example is not assist.rsso-q.example, so the key gives the fake page nothing to pass on.",
          "send": [
            {
              "route": [
                "key",
                "ben",
                "fake"
              ],
              "kind": "secure",
              "label": "Which site?",
              "blockAt": "fake"
            }
          ],
          "set": {
            "key": "ok|✓ Wrong site",
            "fake": "bad|Gets nothing"
          }
        },
        {
          "title": "On the real portal, it just works",
          "text": "From his bookmark, the address matches, and Ben is in with one touch: no code to type, and nothing for a fake page to steal.",
          "send": [
            {
              "route": [
                "key",
