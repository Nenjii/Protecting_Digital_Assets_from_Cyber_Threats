{
  "name": "pdac-web",
  "private": true,
  "version": "1.0.0",
  "description": "Web presentation for Protecting Digital Assets from Cyber Threats (DICT ILCDB). Runs fully offline.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node tools/check-offline.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "preview:lan": "vite preview --host --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "check": "node tools/check-slides.mjs && node tools/check-data.mjs",
    "check:offline": "node tools/check-offline.mjs",
    "qr": "node tools/make-qr.mjs",
    "import-deck": "node tools/import-deck.mjs",
    "shots": "node tools/screenshots.mjs",
    "test": "node tools/smoke-test.mjs",
    "attack": "node tools/attack-extract.mjs",
    "kev": "node tools/kev-extract.mjs",
    "threat-dragon": "node tools/threat-dragon-models.mjs",
    "poll-pack": "node tools/poll-pack.mjs",
    "range:build": "vite build --config vite.range.config.ts",
    "range": "npm run range:build && node range/server/main.mjs",
    "range:typecheck": "tsc --noEmit -p range/tsconfig.json",
    "range:test": "node range/tools/engine-test.mjs && node range/tools/range-e2e.mjs",
    "range:check": "node range/tools/check-range.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "5.2.8",
    "@fontsource/source-serif-4": "5.2.9",
    "@zxcvbn-ts/core": "4.2.0",
    "@zxcvbn-ts/language-common": "4.1.3",
    "@zxcvbn-ts/language-en": "4.1.1",
    "lucide": "1.48.0",
    "qrcode": "1.5.4",
    "reveal.js": "5.2.1"
  },
  "devDependencies": {
    "@types/reveal.js": "5.2.2",
    "jszip": "3.10.1",
    "playwright-core": "1.63.0",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
